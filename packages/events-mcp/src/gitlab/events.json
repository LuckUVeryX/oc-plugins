{
  "events": [
    {
      "name": "ciPipelineStatusesUpdated",
      "description": "Triggered when any pipeline status is updated.\n\nParams: projectId (global id, gid://gitlab/Project/599) or projectFullPath, optional sha.",
      "params": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "pattern": "^gid://gitlab/Project/\\d+$",
            "description": "A GitLab global ID such as gid://gitlab/Project/123, not the number in the web URL."
          },
          "projectFullPath": {
            "type": "string",
            "description": "Full path of the project."
          },
          "sha": {
            "type": "string",
            "description": "Filter updates to pipelines run for the given commit SHA."
          }
        },
        "anyOf": [
          {
            "required": ["projectId"]
          },
          {
            "required": ["projectFullPath"]
          }
        ],
        "additionalProperties": false
      },
      "query": "subscription($projectId: ProjectID, $projectFullPath: ID, $sha: String) { ciPipelineStatusesUpdated(projectId: $projectId, projectFullPath: $projectFullPath, sha: $sha) { id iid name status ref sha source path duration failureReason createdAt updatedAt finishedAt detailedStatus { name label text } project { id fullPath name webUrl } mergeRequest { id iid title state webUrl } user { username name } } }",
      "payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "iid": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "WAITING_FOR_RESOURCE",
              "PREPARING",
              "WAITING_FOR_CALLBACK",
              "PENDING",
              "RUNNING",
              "FAILED",
              "SUCCESS",
              "CANCELING",
              "CANCELED",
              "SKIPPED",
              "MANUAL",
              "SCHEDULED"
            ]
          },
          "ref": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "failureReason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string"
          },
          "detailedStatus": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "project": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "fullPath": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "webUrl": {
                "type": "string"
              }
            },
            "required": ["id", "fullPath", "name"]
          },
          "mergeRequest": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "iid": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": ["merged", "opened", "closed", "locked", "all"]
              },
              "webUrl": {
                "type": "string"
              }
            },
            "required": ["id", "iid", "title", "state"]
          },
          "user": {
            "type": "object",
            "properties": {
              "username": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["username", "name"]
          }
        },
        "required": ["id", "iid", "status", "createdAt", "updatedAt", "detailedStatus"]
      }
    },
