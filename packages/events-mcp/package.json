{
  "name": "@luckuveryx/events-mcp",
  "version": "0.1.0",
  "description": "Local Lark, GitLab, and Codemagic MCP events server, shared by every agent session on the machine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuckUVeryX/oc-plugins.git",
    "directory": "packages/events-mcp"
  },
  "bin": {
    "events-mcp": "./dist/main.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/main.ts --target node --packages external --outfile dist/main.js",
    "prepack": "bun run build",
    "generate": "bun ../../scripts/events-mcp/generate-sdk-events.ts",
    "generate:gitlab": "bun ../../scripts/events-mcp/generate-gitlab-events.ts",
    "generate:check": "bun ../../scripts/events-mcp/generate-sdk-events.ts --check && bun ../../scripts/events-mcp/generate-gitlab-events.ts --check",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "test": "bun --bun vitest run --passWithNoTests",
    "check": "bun run generate:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.1.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@opencode/client": "2.4.1",
    "@opencode/codemode": "2.4.1",
    "@opencode/schema": "2.4.1",
    "@opencode/util": "2.4.1",
    "effect": "4.1.0",
    "socket.io-client": "4.8.4",
    "ws": "8.23.0"
  },
  "engines": {
    "node": ">=24"
  }
}
