{
  "name": "oc-lark-decisions",
  "version": "0.0.0",
  "private": true,
  "description": "Relay Lark events through OpenCode decisions into a session, built with Effect",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transform": "./src/transform.ts"
  },
  "scripts": {
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "test": "bun --bun vitest run",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opencode/schema": "2.3.0",
    "effect": "4.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
